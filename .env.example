# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
TAVILY_API_KEY=

# Optional: pin models instead of auto-picking from /v1/models
# FP_AGENT_MODEL=
# FP_VISION_MODEL=

# Optional: Cosmos-Reason endpoint (docs/NEBIUS_SETUP.md)
# FP_VISION_BASE_URL=
# FP_VISION_API_KEY=

# Drone: sim (default) or mavlink
# FP_DRONE=sim
# FP_MAVLINK_URL=udpin:0.0.0.0:14550
